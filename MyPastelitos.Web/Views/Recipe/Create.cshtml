@model CreateRecipeDTO

@section Styles {
  <link href="~/lib/summernote/summernote-bs5.min.css" rel="stylesheet"/>
}


@{
    ViewData["Title"] = "Nueva Receta";
}
<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Recetas</a></li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">

    <div class="card">
        <div class="card-header">

            <div class="row">  
               

                 <h3 class="m-0 font-weight-bold text-primary col-md-11">@ViewData["Title"]</h3>


            </div>
        </div>

        <div class="card-body">

        <form asp-action="Create" method="POST" class="row g-3 nt-2">

                <div class ="col-md-12">
                    <div class="form-floating">     
                           <input asp-for="Name" class= "form-control" placeholder="@Html.DisplayFor(dto => dto.Name)" />
                           <label asp-for="Name" class="form-label"></label>
                            <span asp-validation-for="Name" class="text-danger"></span>
                     </div>
                </div>

                <div class ="col-md-12">
                    <div class="form-floating">     
                           <select asp-for="SectionId" asp-items="Model.Sections" class= "form-control"> </select>
                           <label asp-for="SectionId" class="form-label"></label>
                            <span asp-validation-for="SectionId" class="text-danger"></span>
                     </div>
                </div>

                <div class ="col-md-12">
                    <div class="form-floating">     
                           <textarea asp-for="Description" class= "form-control"  rows="40"></textarea>
                        @*   <label asp-for="Description"></label> *@
                            <span asp-validation-for="Description" class="text-danger"></span>
                     </div>
                </div>



                            <div class="text-center mt-3">
                                   <button class="btn btn-primary" type="submit">Guardar</button>
                                   <a asp-action= "Index" class="btn btn-secondary">Cancelar</a>

                            </div>



        </form>
            
        </div>
        
        
    </div>
            
    </section>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");}

        <script src="~/lib/summernote/summernote-bs5.min.js"> </script>
        <script src="~/lib/summernote/lang/summernote-es-ES.min.js"> </script>

        <script>    
            $(document).ready(function() {
                $('#Description').summernote({

                  lang: 'es-ES', 
                  placeholder: 'Escriba la descripción de la receta aquí...',

                });
                   
            });
        </script>
}