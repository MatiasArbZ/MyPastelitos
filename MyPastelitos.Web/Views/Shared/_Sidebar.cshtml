@inject MyPastelitos.Web.Services.Abstractions.IAccountService _accountService;

<aside id="sidebar" class="sidebar">

    <ul class="sidebar-nav" id="sidebar-nav">

      <li class="nav-item">
        <a class="nav-link " asp-controller="Home" asp-action="Index">
          <i class="bi bi-grid"></i>
          <span>Dashboard</span>
        </a>
      </li>


        @if (await _accountService.AccountUserIsAuthorizedAsync("sections.show"))
        {
            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="Sections" asp-action="Index">
                    <i class="bi bi-shop"></i>
                    <span>Productos</span>
                </a>
            </li>
        }

        @if (await _accountService.AccountUserIsAuthorizedAsync("recipe.show"))
        {
            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="Recipe" asp-action="Index">
                    <i class="bi bi-shop"></i>
                    <span>Recetas</span>
                </a>
            </li>

        }
        
    </ul>

  </aside>
